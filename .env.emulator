# ใช้ตอนรัน `npm run dev:emu` — ต่อกับ Firebase Emulator บนเครื่อง ไม่ต้องมี project จริง
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-loy-kratong.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-loy-kratong-default-rtdb
VITE_FIREBASE_PROJECT_ID=demo-loy-kratong
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_EMULATOR=true
